{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Library code runs outside Bun too, so don't allow Bun's globals here
    "types": [],

    // Emit
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "src/country-coder.ts"
  ]
}
